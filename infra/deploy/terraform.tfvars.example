cloudflare_api_token  = "use-TF_VAR_cloudflare_api_token-instead"
cloudflare_account_id = "your-cloudflare-account-id"
zone_name              = "hyperchad.dev"
app_subdomain           = "wwmtf"
fly_app_name            = "words-with-spouses"
fly_ipv6_address        = "discover-with-flyctl"
fly_ownership_txt       = "discover-with-flyctl"
state_bucket_name       = "words-with-spouses-opentofu-state"

# The guarded preflight creates or adopts only the shared redirect phase.
manage_redirect_ruleset = true

# Other shared phases stay disabled until their existing rules are inventoried
# and imported into this stack.
manage_firewall_ruleset         = false
manage_managed_waf_ruleset      = false
manage_rate_limit_ruleset       = false
manage_cache_ruleset            = false
manage_security_headers_ruleset = false

# Creating a widget does not integrate Turnstile into the app by itself.
manage_turnstile = false

# Optional: set to a managed ruleset ID returned by the Cloudflare API and
# available to this zone's plan before enabling shared zone rulesets.
cloudflare_managed_ruleset_id = null
